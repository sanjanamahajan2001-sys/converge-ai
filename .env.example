# ==============================================================================
# Converge AI — Application Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Application Meta
PROJECT_NAME=Converge AI — Conference Agent Network
VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Bindings (Default: 127.0.0.1:8030)
HOST=127.0.0.1
PORT=8030
API_V1_PREFIX=/converge-api/v1

# Trusted Proxies (JSON list or comma-separated IPs for reverse proxy trust)
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# Database Configuration (WS-3 Two-Role Model - GAP-02)
# Runtime Application Role (DML only: SELECT, INSERT, UPDATE, DELETE)
DATABASE_URL=postgresql+asyncpg://converge_ai_app:local_app_secret@127.0.0.1:5432/converge_ai_db

# Migration/DDL Owner Role (Used by Alembic runner)
MIGRATION_DATABASE_URL=postgresql+psycopg2://converge_ai_owner:local_owner_secret@127.0.0.1:5432/converge_ai_db

# Isolated Test Database
TEST_DATABASE_URL=postgresql+asyncpg://converge_ai_app:local_app_secret@127.0.0.1:5432/converge_ai_test

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# AI Provider Credentials (Placeholder for Phase 5; optional in WS-3)
# GEMINI_API_KEY=
